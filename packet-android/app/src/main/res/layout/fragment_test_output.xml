<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F7"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="30dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <ImageButton
            android:id="@+id/testOutputCloseButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Close test output"
            android:elevation="0dp"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            android:stateListAnimator="@null"
            android:tint="#111827" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Test Output"
            android:textColor="#111827"
            android:textSize="20sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="20dp"
        android:text="Output"
        android:textColor="#8E8E93"
        android:textSize="17sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/testOutputScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_panel"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/testOutputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:breakStrategy="high_quality"
            android:gravity="top|start"
            android:hyphenationFrequency="none"
            android:lineSpacingExtra="3dp"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp"
            android:scrollHorizontally="false"
            android:text="No test output yet."
            android:textColor="#111827"
            android:textIsSelectable="true"
            android:textSize="11sp"
            android:typeface="monospace" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/testOutputRunButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="Run Test"
            android:textAllCaps="false"
            android:textColor="#2563EB"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/testOutputCopyButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_primary_button"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="Copy Output"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
