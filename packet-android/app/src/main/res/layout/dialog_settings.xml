<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/settingsDialogContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Settings"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/settingsCloseButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:contentDescription="Close settings"
                android:elevation="0dp"
                android:padding="4dp"
                android:src="@drawable/ic_close"
                android:stateListAnimator="@null"
                android:tint="#111827" />
        </LinearLayout>

        <TextView
            android:id="@+id/settingsErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#B42318"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="SERVER URL"
            android:textColor="#6B7280"
            android:textSize="9sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/settingsServerUrlInput"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:hint="https://example.com"
            android:inputType="textUri"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#111827"
            android:textColorHint="#9CA3AF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="SHARED SECRET"
            android:textColor="#6B7280"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/settingsSecretInput"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_field"
                android:hint="Enter shared secret"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/secretToggleVisibility"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Toggle secret visibility"
                android:elevation="0dp"
                android:padding="12dp"
                android:src="@drawable/ic_visibility"
                android:stateListAnimator="@null"
                android:tint="#4B5563" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="LISTEN PORT"
            android:textColor="#6B7280"
            android:textSize="9sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/settingsListenPortInput"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:hint="Auto"
            android:inputType="number"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#111827"
            android:textColorHint="#9CA3AF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="TRANSPORT"
            android:textColor="#6B7280"
            android:textSize="9sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/settingsTransportSpinner"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:spinnerMode="dropdown" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="CDN EDGE"
            android:textColor="#6B7280"
            android:textSize="9sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/settingsCdnEdgeInput"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:hint="185.143.234.235:80"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#111827"
            android:textColorHint="#9CA3AF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="HOST OVERRIDE"
            android:textColor="#6B7280"
            android:textSize="9sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/settingsHostOverrideInput"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:hint="your-domain.com"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#111827"
            android:textColorHint="#9CA3AF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="SNI OVERRIDE"
            android:textColor="#6B7280"
            android:textSize="9sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/settingsSniOverrideInput"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:hint="allowed-site.ir"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#111827"
            android:textColorHint="#9CA3AF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/settingsCancelButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#2563EB"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/settingsSaveButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_button"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="Save"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
